PORT=3000

# Secret that signs logins. Leave blank and the app makes a private one for you (saved in .jwt-secret).
# To choose your own, use a long random string (32+ characters).
JWT_SECRET=

# Only needed if the web page is hosted on a different website from this server. Comma separated.
# Leave blank when the app serves its own page (the normal case).
ALLOWED_ORIGINS=

# Twilio WhatsApp Sandbox (leave blank to run in dry-run mode: messages print to the console)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your public website address, e.g. https://lockedin.example.com (no slash at the end).
# Used to confirm WhatsApp messages really come from Twilio. Set this when you go live.
PUBLIC_URL=

# Emergency switch: set to "off" ONLY if WhatsApp replies stop working on demo day.
# WEBHOOK_VERIFY=off
